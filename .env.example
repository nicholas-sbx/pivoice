# Copy to .env.local. Everything here is optional.

# Canonical public URL, used for the invite link. Defaults to wherever the app was opened from.
# VITE_PUBLIC_URL=https://pivoice.example.com/

# A TURN relay baked into the build. Anyone who opens the app can read these.
# Prefer the Worker's /api/ice endpoint (short-lived Cloudflare TURN credentials).
# VITE_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
